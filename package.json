{
  "name": "pdf-converter-cli",
  "version": "1.0.0",
  "description": "Tools to convert hymn PDFs to Markdown using Adobe PDF Services API and restructure OCR text into GospelCue-style hymn text using an LLM.",
  "main": "dist/index.js",
  "bin": {
    "pdf-converter": "dist/index.js",
    "restructure-hymns": "dist/restructure-hymns.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "restructure": "ts-node src/restructure-hymns.ts"
  },
  "dependencies": {
    "@adobe/pdfservices-node-sdk": "^4.1.0",
    "axios": "^1.7.7",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "inquirer": "^9.3.6",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/adobe__pdfservices-node-sdk": "^2.2.3",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
