{
  "name": "pdf-converter-cli",
  "version": "1.1.0",
  "description": "Tools to convert hymn PDFs to Markdown using Adobe PDF Services API and process them into GospelCue-style hymn records.",
  "main": "dist/index.js",
  "bin": {
    "pdf-converter": "dist/index.js",
    "create-review-batches": "dist/create-review-batches.js",
    "split-songs": "dist/split-songs.js",
    "restructure-hymns": "dist/restructure-hymns.js",
    "build-metadata-csv": "dist/build-metadata-csv.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "make-batches": "ts-node src/create-review-batches.ts",
    "split-songs": "ts-node src/split-songs.ts",
    "restructure": "ts-node src/restructure-hymns.ts",
    "build-metadata": "ts-node src/build-metadata-csv.ts"
  },
  "dependencies": {
    "@adobe/pdfservices-node-sdk": "^4.1.0",
    "axios": "^1.7.7",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "inquirer": "^9.3.6",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/adobe__pdfservices-node-sdk": "^2.2.3",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}